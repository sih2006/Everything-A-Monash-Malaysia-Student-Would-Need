# Copy this file to ".env" and change what you need. ".env" is never committed.

# Where the app listens. 127.0.0.1 means only this computer can open it.
HOST=127.0.0.1
PORT=8080

# The Gemini API key turns on the AI helper. Leave it empty to keep the helper off.
# How to get one: docs/handoff/gemini-setup.md
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set a long random token before letting other devices reach the app (HOST=0.0.0.0).
APP_TOKEN=

# Where the data is kept, and where the C++ engine is. The defaults work after a normal build.
# DATA_FILE=backend/data/app.db
# TRACKER_ENGINE=core/build/tracker
